DPATH := $(PLATFORM_PATH)/ocs-led-daemon

DEP_FILES := $(SONIC_COMMON_FILES_LIST) $(PLATFORM_PATH)/ocs-led-daemon.mk $(PLATFORM_PATH)/ocs-led-daemon.dep
DEP_FILES += $(SONIC_COMMON_BASE_FILES_LIST)
DEP_FILES += $(shell git ls-files $(DPATH))

$(OCS_LED_DAEMON)_CACHE_MODE  := GIT_CONTENT_SHA
$(OCS_LED_DAEMON)_DEP_FLAGS   := $(SONIC_COMMON_FLAGS_LIST)
$(OCS_LED_DAEMON)_DEP_FILES   := $(DEP_FILES)
